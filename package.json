{
  "name": "auto-cicd-cli",
  "version": "1.0.1",
  "description": "Production-ready CLI tool automating GitHub authentication, repository webhook setup, and CI/CD pipeline management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "auto-cicd-cli": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "receiver": "tsx src/dev-receiver.ts",
    "receiver:restart": "node scripts/restart-receiver.mjs",
    "server": "tsx src/index.ts serve",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "webhook",
    "cli",
    "oauth",
    "vps",
    "automation",
    "octokit",
    "commander",
    "cicd",
    "deploy",
    "devops"
  ],
  "author": "YashDevani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YashDevani-source/AirLock.git"
  },
  "homepage": "https://github.com/YashDevani-source/AirLock#readme",
  "bugs": {
    "url": "https://github.com/YashDevani-source/AirLock/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "@octokit/auth-oauth-device": "^7.1.3",
    "@octokit/rest": "^21.1.1",
    "auto-cicd-cli": "^1.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "dotenv": "^16.4.7",
    "kill-port": "^2.0.1",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
